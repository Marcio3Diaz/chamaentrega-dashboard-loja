# URL pública do site. Em produção é obrigatória e deve usar o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Configuração interna da plataforma ChamaEntrega.
# Nunca pedir estes valores às lojas clientes.
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# Opcional: use quando a configuração da Meta exigir redirect URI explícita.
META_WHATSAPP_REDIRECT_URI=

# Opcional: habilite somente se a configuração Embedded Signup da Meta suportar coexistência.
# Exemplo: whatsapp_business_app_onboarding
META_WHATSAPP_FEATURE_TYPE=

# Migração paralela Supabase -> MySQL.
# Deixe vazio em produção enquanto a fase de shadow/dual-run não estiver aprovada.
CHAMA_MIGRATION_API_URL=
CHAMA_MIGRATION_API_KEY=
CHAMA_MYSQL_SHADOW_WRITE=false
