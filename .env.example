# URL pública do site. Em produção é obrigatória e deve usar o domínio real.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Banco principal durante a migração.
# Valores aceitos: supabase | mysql
DATABASE_PROVIDER=supabase

# Supabase continua ativo enquanto a migração for feita por módulos.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente para scripts administrativos de migração no servidor/local.
# Nunca expor no navegador ou em variáveis NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# MySQL (ainda não usado pelas consultas enquanto DATABASE_PROVIDER=supabase).
# Exemplo:
# mysql://usuario:senha@127.0.0.1:3306/chamaentrega
MYSQL_DATABASE_URL=
# Em Railway, MYSQL_URL também é aceita automaticamente.

# Durante a transição, sincroniza dados operacionais ainda escritos no Supabase
# para o MySQL antes das leituras do dashboard.
MYSQL_SYNC_FROM_SUPABASE=false

# Configuração interna da plataforma ChamaEntrega.
# Nunca pedir estes valores às lojas clientes.
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# Opcional: use quando a configuração da Meta exigir redirect URI explícita.
META_WHATSAPP_REDIRECT_URI=

# Opcional: habilite somente se a configuração Embedded Signup da Meta suportar coexistência.
# Exemplo: whatsapp_business_app_onboarding
META_WHATSAPP_FEATURE_TYPE=

# Integração servidor-servidor com o app da Serafina.
# SERAFINA_API_KEY deve ser igual a CHAMAENTREGA_API_KEY no backend da Serafina.
# SERAFINA_STORE_ID é o UUID da loja Serafina cadastrada no ChamaEntrega.
SERAFINA_API_KEY=substitua-por-uma-chave-aleatoria-forte
SERAFINA_STORE_ID=00000000-0000-4000-8000-000000000000

# Webhook servidor-servidor para a Serafina.
# Em produção use HTTPS e o mesmo segredo forte configurado em
# CHAMAENTREGA_WEBHOOK_SECRET no backend da Serafina.
# O ChamaEntrega envia X-ChamaEntrega-Event-Id, X-ChamaEntrega-Timestamp e
# X-ChamaEntrega-Signature=sha256=<HMAC(timestamp.raw-body)>.
SERAFINA_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/integrations/chamaentrega/webhook
SERAFINA_WEBHOOK_SECRET=substitua-por-um-segredo-forte-compartilhado

# Opcional: Map ID próprio. Sem ele o app usa DEMO_MAP_ID em desenvolvimento.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Chave do servidor: restrinja por API e habilite Geocoding API.
GOOGLE_MAPS_API_KEY=
