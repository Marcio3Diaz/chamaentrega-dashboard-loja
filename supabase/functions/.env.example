# ChamaEntrega — referência de variáveis das Supabase Edge Functions
# Use somente placeholders neste arquivo. Nunca versionar valores reais.

# -------------------------------------------------------------------
# Variáveis fornecidas pelo ambiente do Supabase
# Normalmente não precisam ser cadastradas manualmente.
# -------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder

# Ambientes novos também podem expor coleções JSON de chaves.
SUPABASE_PUBLISHABLE_KEYS={"default":"placeholder"}
SUPABASE_SECRET_KEYS={"default":"placeholder"}

# -------------------------------------------------------------------
# Push / Firebase
# SEGREDOS: configurar apenas no ambiente das Edge Functions.
# -------------------------------------------------------------------
DELIVERY_WEBHOOK_SECRET=replace-with-random-secret
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-with-base64-service-account-json

# -------------------------------------------------------------------
# Serafina — callback operacional de entregas
# A mesma função que recebe eventos de deliveries encaminha alterações
# reais do entregador para o backend da Serafina com HMAC-SHA256.
# Use a mesma SERAFINA_WEBHOOK_SECRET configurada no backend Serafina.
# Nunca use uma URL HTTP em ambiente remoto.
# -------------------------------------------------------------------
SERAFINA_WEBHOOK_URL=https://api.example.com/api/v1/integrations/chamaentrega/webhook
SERAFINA_WEBHOOK_SECRET=replace-with-shared-serafina-webhook-secret

# -------------------------------------------------------------------
# Pix / Woovi
# SEGREDOS: nunca enviar ao navegador.
# -------------------------------------------------------------------
WOOVI_APP_ID=replace-with-woovi-app-id
WOOVI_WEBHOOK_SECRET=replace-with-webhook-secret

# -------------------------------------------------------------------
# WhatsApp / Meta
# META_WHATSAPP_APP_ID e META_WHATSAPP_CONFIG_ID podem ser enviados ao
# navegador pelo fluxo autenticado de Embedded Signup.
# APP_SECRET e VERIFY_TOKEN permanecem somente no servidor.
# -------------------------------------------------------------------
META_WHATSAPP_APP_ID=replace-with-meta-app-id
META_WHATSAPP_APP_SECRET=replace-with-meta-app-secret
META_WHATSAPP_CONFIG_ID=replace-with-meta-config-id
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_FEATURE_TYPE=

WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token

# Nunca colocar estes segredos em variáveis NEXT_PUBLIC_*.
