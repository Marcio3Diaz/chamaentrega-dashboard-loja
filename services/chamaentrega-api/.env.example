PORT=3301

# Example only. Do not commit real credentials.
MYSQL_URL=mysql://chamaentrega:strong-password@127.0.0.1:3306/chamaentrega?ssl=false
MYSQL_CONNECTION_LIMIT=10

# At least 32 random characters. Used only for dashboard -> migration API calls.
CHAMA_INTERNAL_API_KEY=replace-with-a-long-random-secret

REQUEST_BODY_LIMIT_BYTES=65536

# Optional during migration. Enable only after Firebase credentials are configured.
FCM_WORKER_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_BASE64=
COURIER_APP_PACKAGE=com.marciodiaz.logistica.entregador
OUTBOX_POLL_MS=1500
OUTBOX_BATCH_SIZE=10

# One-time operational baseline copy for the isolated MySQL environment.
# Use a server-side Supabase secret/service-role key. Never expose it to the browser.
SUPABASE_SOURCE_URL=
SUPABASE_SOURCE_SERVICE_ROLE_KEY=
MIGRATION_BOOTSTRAP_CONFIRM=
MIGRATION_BOOTSTRAP_ALLOW_NONEMPTY=false

# Optional MySQL maintenance loop. Keep false until shadow data is validated.
DELIVERY_MAINTENANCE_ENABLED=false
DELIVERY_MAINTENANCE_POLL_MS=5000
DELIVERY_MAINTENANCE_BATCH_SIZE=100
